{
    "name": "dept-of-scrapyard-robotics/lis3dx",
    "description": "Drive LIS3DH & LIS3DSH accelerometers over I2C/SPI with PHP",
    "type": "library",
    "version": "0.7.0",
    "keywords": [
        "lis3dh",
        "lis3dsh",
        "accelerometer",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "fabricate/nuts-and-bolts": "^0.7.0",
        "gpio/circuits": "^0.7.0",
        "gpio/contracts": "^0.7.0",
        "gpio/digital": "^0.7.0",
        "gpio/i2c": "^0.7.0",
        "gpio/spi": "^0.7.0",
        "waveforms/contracts": "^0.7.0"
    },
    "suggest": {
        "microscrap/i2c": "^0.7.0 - POSIX I2C",
        "microscrap/spi": "^0.7.0 - POSIX SPI",
        "microscrap/mpsse": "^0.7.0 - I2C/SPI over FTDI MPSSE"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Sensors\\LIS3Dx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.7.x-dev"
        },
        "scrapyard-io": {
            "providers": [
                "DeptOfScrapyardRobotics\\Sensors\\LIS3Dx\\LIS3DxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
